# Mupit local configuration. Copy to .env (gitignored) and fill in.
# Never commit real keys or tokens.

# --- Server ---
# Bind address MUST stay loopback. Port for the MCP Streamable HTTP endpoint.
MUPIT_HOST=127.0.0.1
MUPIT_PORT=3000
MUPIT_DB_PATH=data/mupit.db

# --- Local secrets (files created by `npm run setup:local`, mode 0600) ---
# You may instead set the values inline; files take precedence unless the
# corresponding *_FILE variable is unset... (see src/config.ts for precedence).
# MUPIT_SERVER_SECRET_FILE=data/.server-secret
# MUPIT_VAULT_KEY_FILE=data/.vault-key
# MUPIT_VAULT_KEY=<base64 of 32 random bytes>

# --- Meta Model API (verified 2026-10-28, https://dev.meta.ai/docs) ---
# Base URL and model for the Mupit facilitator and live simulator agents.
# Get a key from the Meta developer platform dashboard.
META_API_KEY=
# MODEL_API_KEY=          # accepted as a fallback alias for META_API_KEY
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# --- Modes ---
# Facilitator: "live" (default, requires META_API_KEY) or "mock" (explicit only).
# The server NEVER silently falls back to mock when live credentials fail.
# MUPIT_FACILITATOR_MODE=live
# Demo provisioning (simulated-participant marking + fixture consent provenance).
# Required for seed/demo scripts; must stay off for any real-user database.
# MUPIT_DEMO_MODE=0

# --- Demo instance (used by seed:demo / demo:* scripts) ---
MUPIT_DEMO_DB_PATH=demo/state/demo.db
MUPIT_DEMO_PORT=3001

# Optional exact trusted HTTPS tunnel hostname (no scheme, port, or wildcard).
# MUPIT_TUNNEL_HOST=your-host.ngrok-free.dev

# Automatic server-owned mediation (default enabled); 0 is manual diagnostic mode.
MUPIT_AUTO_MEDIATION=1
